<!doctype html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <title>Disk Space Visualizer Dashboard</title>
  <style>
    :root {
      --glass-bg: rgba(255, 255, 255, 0.08);
      --glass-strong: rgba(18, 24, 38, 0.72);
      --glass-border: rgba(255, 255, 255, 0.16);
      --glass-highlight: rgba(255, 255, 255, 0.24);
      --glass-shadow: 0 22px 60px rgba(0, 0, 0, 0.28);
      --glass-blur: 24px;
      --page-bg: #07101c;
      --panel-bg: rgba(10, 20, 34, 0.76);
      --text-primary: #f4f7fb;
      --text-secondary: #9cabbc;
      --line: rgba(255, 255, 255, 0.11);
      --accent-color: #62d7c9;
      --accent-blue: #72a7ff;
      --accent-orange: #ffb25f;
      --accent-rose: #ff7e9f;
      --danger: #ff7188;
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      --radius: 8px;
    }
    html[data-theme="light"] {
      --glass-bg: rgba(255, 255, 255, 0.54);
      --glass-strong: rgba(255, 255, 255, 0.78);
      --glass-border: rgba(255, 255, 255, 0.88);
      --glass-highlight: rgba(255, 255, 255, 0.98);
      --glass-shadow: 0 22px 58px rgba(42, 64, 93, 0.16);
      --page-bg: #e9f1f8;
      --panel-bg: rgba(247, 251, 255, 0.78);
      --text-primary: #152238;
      --text-secondary: #617087;
      --line: rgba(28, 50, 78, 0.12);
      --accent-color: #178f84;
      --accent-blue: #3d79d8;
      --accent-orange: #d98021;
      --accent-rose: #ce4e73;
      --danger: #ca3854;
    }
    * { box-sizing: border-box; }
    html { min-width: 320px; background: var(--page-bg); }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text-primary);
      background:
        radial-gradient(circle at 12% 4%, rgba(75, 142, 214, 0.28), transparent 34rem),
        radial-gradient(circle at 88% 18%, rgba(63, 190, 168, 0.2), transparent 32rem),
        radial-gradient(circle at 62% 92%, rgba(220, 120, 118, 0.15), transparent 28rem),
        var(--page-bg);
      font-family: Inter, "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0;
    }
    button, input { font: inherit; }
    button { color: inherit; }
    .glass {
      background: linear-gradient(145deg, var(--glass-highlight), transparent 34%), var(--glass-bg);
      border: 1px solid var(--glass-border);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.12), var(--glass-shadow);
      backdrop-filter: blur(var(--glass-blur)) saturate(150%);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    }
    .app-shell { width: min(1600px, 100%); margin: 0 auto; padding: 16px; }
    .topbar {
      position: sticky; top: 10px; z-index: 20;
      min-height: 66px; display: flex; align-items: center; gap: 18px;
      padding: 10px 14px; border-radius: var(--radius);
    }
    .brand { min-width: 220px; }
    .brand strong { display: block; font-size: 16px; }
    .brand span, .root-path { color: var(--text-secondary); font-size: 12px; }
    .root-path { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
    .tabs { display: flex; gap: 4px; }
    .tab, .icon-button, .command-button, .breadcrumb-button {
      border: 1px solid transparent; background: transparent; border-radius: 7px;
      cursor: pointer; transition: transform 140ms var(--ease-out), background-color 180ms ease,
        border-color 180ms ease, color 180ms ease;
    }
    .tab { padding: 9px 12px; color: var(--text-secondary); }
    .tab[aria-selected="true"] { color: var(--text-primary); background: var(--glass-bg); border-color: var(--line); }
    .icon-button { min-width: 38px; height: 38px; padding: 0 10px; border-color: var(--line); background: var(--glass-bg); }
    .command-button { display: inline-flex; align-items: center; justify-content: center; padding: 9px 13px; color: inherit; text-decoration: none; background: var(--glass-bg); border-color: var(--line); }
    .command-button.primary { background: var(--accent-color); color: #061715; border-color: transparent; font-weight: 700; }
    .command-button.danger { color: var(--danger); }
    button:active { transform: scale(.97); }
    button:disabled { opacity: .45; cursor: not-allowed; }
    .status-strip {
      margin-top: 12px; display: grid; grid-template-columns: minmax(180px, 1.2fr) repeat(4, auto);
      gap: 14px; align-items: center; padding: 10px 14px; border-radius: var(--radius);
      color: var(--text-secondary); font-size: 12px;
    }
    .status-path { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--text-secondary); display: inline-block; margin-right: 7px; }
    .status-dot.running { background: var(--accent-color); box-shadow: 0 0 0 5px rgba(98,215,201,.12); }
    main { padding: 18px 0 40px; }
    .view { display: none; }
    .view.active { display: block; }
    .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin: 8px 2px 12px; }
    .section-heading h1, .section-heading h2 { margin: 0; font-size: 20px; }
    .section-heading p { margin: 4px 0 0; color: var(--text-secondary); font-size: 13px; }
    .metric-grid { display: grid; grid-template-columns: repeat(6, minmax(130px, 1fr)); gap: 10px; }
    .metric { min-height: 116px; padding: 16px; border-radius: var(--radius); }
    .metric-label { color: var(--text-secondary); font-size: 12px; }
    .metric-value { margin-top: 14px; font-size: 24px; font-weight: 720; overflow-wrap: anywhere; }
    .metric-detail { margin-top: 7px; color: var(--text-secondary); font-size: 11px; }
    .content-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .75fr); gap: 12px; margin-top: 12px; }
    .panel { padding: 16px; border-radius: var(--radius); min-width: 0; }
    .panel-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 13px; }
    .panel-title h2 { margin: 0; font-size: 15px; }
    .panel-title span { color: var(--text-secondary); font-size: 12px; }
    .capacity-row { display: flex; align-items: center; gap: 22px; min-height: 240px; }
    .capacity-ring { width: 160px; aspect-ratio: 1; border-radius: 50%; position: relative; background: conic-gradient(var(--accent-color) var(--used-angle, 0deg), var(--line) 0); flex: 0 0 auto; }
    .capacity-ring::after { content: ""; position: absolute; inset: 18px; border-radius: 50%; background: var(--panel-bg); border: 1px solid var(--line); }
    .capacity-ring strong { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; font-size: 26px; }
    .legend { display: grid; gap: 12px; flex: 1; }
    .legend-row { display: grid; grid-template-columns: 10px minmax(0,1fr) auto; gap: 9px; align-items: center; font-size: 12px; }
    .swatch { width: 9px; height: 9px; border-radius: 2px; }
    .bar-list { display: grid; gap: 10px; }
    .bar-row { display: grid; grid-template-columns: minmax(100px, 1fr) minmax(90px, 2fr) auto; gap: 10px; align-items: center; font-size: 12px; }
    .bar-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bar-track { height: 7px; border-radius: 3px; background: var(--line); overflow: hidden; }
    .bar-fill { height: 100%; border-radius: inherit; background: var(--accent-blue); }
    .toolbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .input { min-width: 180px; height: 38px; padding: 0 11px; border-radius: 7px; border: 1px solid var(--line); color: var(--text-primary); background: var(--glass-bg); outline: none; }
    .input:focus { border-color: var(--accent-color); box-shadow: 0 0 0 3px rgba(98,215,201,.12); }
    .browser-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(310px, .7fr); gap: 12px; }
    .browser-panel { min-height: 570px; }
    .breadcrumbs { display: flex; gap: 4px; min-width: 0; overflow-x: auto; scrollbar-width: thin; padding-bottom: 4px; }
    .breadcrumb-button { flex: 0 0 auto; padding: 6px 8px; color: var(--text-secondary); }
    .breadcrumb-button:last-child { color: var(--text-primary); background: var(--glass-bg); }
    .treemap { position: relative; height: 410px; border-radius: 7px; overflow: hidden; background: rgba(0,0,0,.12); border: 1px solid var(--line); }
    .tree-cell { position: absolute; padding: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,.25); color: #06101d; text-align: left; cursor: pointer; transition: filter 160ms ease, transform 140ms var(--ease-out); }
    .tree-cell strong, .tree-cell small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tree-cell small { margin-top: 4px; opacity: .72; }
    .tree-cell:focus-visible { outline: 3px solid #fff; outline-offset: -4px; }
    .directory-meta { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .meta-item { padding: 11px; background: var(--glass-bg); border: 1px solid var(--line); border-radius: 7px; }
    .meta-item span { display: block; color: var(--text-secondary); font-size: 11px; }
    .meta-item strong { display: block; margin-top: 6px; font-size: 15px; }
    .table-scroll { width: 100%; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th { color: var(--text-secondary); text-align: left; font-weight: 600; }
    th, td { padding: 10px 8px; border-bottom: 1px solid var(--line); }
    td.path { max-width: 450px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .analysis-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .history-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr); gap: 12px; }
    .trend-chart { width: 100%; height: 290px; }
    .trend-line { fill: none; stroke: var(--accent-color); stroke-width: 3; vector-effect: non-scaling-stroke; }
    .trend-area { fill: rgba(98,215,201,.12); }
    .trend-dot { fill: var(--accent-color); stroke: var(--panel-bg); stroke-width: 3; vector-effect: non-scaling-stroke; }
    .empty { display: grid; place-items: center; min-height: 180px; color: var(--text-secondary); text-align: center; }
    .notice { display: none; margin-top: 12px; padding: 12px 14px; border-radius: 7px; background: rgba(255,113,136,.12); border: 1px solid rgba(255,113,136,.32); color: var(--danger); }
    .notice.warning { background: rgba(255,178,95,.12); border-color: rgba(255,178,95,.32); color: var(--accent-orange); }
    .pager { display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin-top: 12px; }
    .pager span { color: var(--text-secondary); font-size: 12px; }
    .diagnostic-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .diagnostic-item { min-height: 88px; padding: 13px; border: 1px solid var(--line); border-radius: 7px; background: var(--glass-bg); }
    .diagnostic-item span { display: block; color: var(--text-secondary); font-size: 11px; }
    .diagnostic-item strong { display: block; margin-top: 8px; font-size: 13px; overflow-wrap: anywhere; }
    .loading-skeleton { min-height: 60vh; display: grid; place-items: center; color: var(--text-secondary); }
    .spinner { width: 26px; height: 26px; border: 3px solid var(--line); border-top-color: var(--accent-color); border-radius: 50%; animation: spin .75s linear infinite; margin: 0 auto 12px; }
    @keyframes spin { to { transform: rotate(360deg); } }
    @media (hover: hover) and (pointer: fine) {
      .tab:hover, .icon-button:hover, .command-button:hover, .breadcrumb-button:hover { background: var(--glass-bg); border-color: var(--line); }
      .tree-cell:hover { filter: brightness(1.08); z-index: 2; }
    }
    @media (max-width: 1100px) {
      .metric-grid { grid-template-columns: repeat(3, 1fr); }
      .topbar { flex-wrap: wrap; }
      .root-path { order: 3; flex-basis: 100%; }
      .content-grid, .browser-layout, .history-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 680px) {
      .app-shell { padding: 8px; }
      .topbar { top: 4px; padding: 9px; gap: 8px; }
      .brand { min-width: 0; flex: 1; }
      .tabs { width: 100%; overflow-x: auto; order: 4; }
      .tab { flex: 1 0 auto; padding: 8px 10px; }
      .status-strip { grid-template-columns: 1fr 1fr; gap: 7px 12px; }
      .status-path { grid-column: 1 / -1; }
      .metric-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
      .metric { min-height: 100px; padding: 13px; }
      .metric-value { font-size: 20px; }
      .analysis-grid { grid-template-columns: 1fr; }
      .diagnostic-grid { grid-template-columns: 1fr; }
      .capacity-row { align-items: flex-start; flex-direction: column; }
      .capacity-ring { width: 135px; align-self: center; }
      .treemap { height: 360px; }
      .panel { padding: 12px; }
      .section-heading { align-items: flex-start; flex-direction: column; }
      .toolbar { width: 100%; }
      .input { min-width: 0; flex: 1 1 150px; }
      td.path { min-width: 250px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <header class="topbar glass">
      <div class="brand"><strong>Disk Space Visualizer</strong><span>Dashboard v{{ app_version }}</span></div>
      <div class="root-path" title="{{ root_path }}">{{ root_path }}</div>
      <nav class="tabs" aria-label="Dashboard views">
        <button class="tab" data-view="overview" aria-selected="true">总览</button>
        <button class="tab" data-view="browser" aria-selected="false">目录</button>
        <button class="tab" data-view="analysis" aria-selected="false">分析</button>
        <button class="tab" data-view="history" aria-selected="false">历史</button>
        <button class="tab" data-view="system" aria-selected="false">系统</button>
      </nav>
      <button class="icon-button" id="themeToggle" type="button" title="切换主题" aria-label="切换主题">主题</button>
    </header>

    <section class="status-strip glass" aria-live="polite">
      <div class="status-path"><span class="status-dot" id="statusDot"></span><span id="statusPath">正在连接本地服务...</span></div>
      <span id="statusFiles">0 个文件</span>
      <span id="statusSpeed">0 文件/秒</span>
      <span id="statusEta">剩余时间计算中</span>
      <button class="command-button danger" id="cancelButton" type="button" disabled>取消</button>
    </section>
    <div class="notice" id="errorNotice" role="alert"></div>

    <main>
      <div class="loading-skeleton" id="loadingState"><div><div class="spinner"></div><div>正在扫描和构建目录索引...</div></div></div>

      <section class="view" id="view-overview">
        <div class="section-heading"><div><h1>空间总览</h1><p>当前卷容量与本次目录扫描结果</p></div><button class="command-button" id="rescanButton" type="button">重新扫描</button></div>
        <div class="metric-grid" id="metricGrid"></div>
        <div class="content-grid">
          <section class="panel glass"><div class="panel-title"><h2>磁盘容量</h2><span id="capacityLabel"></span></div><div class="capacity-row"><div class="capacity-ring" id="capacityRing"><strong id="capacityPercent">0%</strong></div><div class="legend" id="capacityLegend"></div></div></section>
          <section class="panel glass"><div class="panel-title"><h2>一级目录占用</h2><span>Top 10</span></div><div class="bar-list" id="folderBars"></div></section>
        </div>
      </section>

      <section class="view" id="view-browser">
        <div class="section-heading"><div><h1>目录浏览器</h1><p>点击空间块进入子目录，路径和表格保持同步</p></div><div class="toolbar"><button class="command-button" id="upButton" type="button">返回上级</button></div></div>
        <div class="browser-layout">
          <section class="panel glass browser-panel"><div class="breadcrumbs" id="breadcrumbs"></div><div class="treemap" id="treemap"></div></section>
          <aside class="panel glass"><div class="panel-title"><h2 id="directoryName">当前目录</h2><span id="directoryPercent"></span></div><div class="directory-meta" id="directoryMeta"></div><div class="panel-title" style="margin-top:18px"><h2>直接文件</h2><span id="directoryFileCount">0 个</span></div><div class="table-scroll"><table><thead><tr><th>文件</th><th>大小</th></tr></thead><tbody id="directoryFiles"></tbody></table></div><div class="pager"><button class="command-button" id="directoryPrev" type="button">上一页</button><span id="directoryPage">0 / 0</span><button class="command-button" id="directoryNext" type="button">下一页</button></div></aside>
        </div>
      </section>

      <section class="view" id="view-analysis">
        <div class="section-heading"><div><h1>文件分析</h1><p>排行、分布、重复文件与精确路径搜索</p></div><div class="toolbar"><input class="input" id="searchInput" type="search" placeholder="搜索文件名或路径"><input class="input" id="minSizeInput" type="text" inputmode="numeric" placeholder="最小字节数"><button class="command-button primary" id="searchButton" type="button">搜索</button></div></div>
        <div class="analysis-grid">
          <section class="panel glass"><div class="panel-title"><h2>最大文件</h2><span>Top</span></div><div class="bar-list" id="largestBars"></div></section>
          <section class="panel glass"><div class="panel-title"><h2>文件类型</h2><span>按空间</span></div><div class="bar-list" id="typeBars"></div></section>
          <section class="panel glass"><div class="panel-title"><h2>大小分布</h2><span>文件数量</span></div><div class="bar-list" id="distributionBars"></div></section>
          <section class="panel glass"><div class="panel-title"><h2>重复文件</h2><span id="duplicateSummary"></span></div><div class="table-scroll"><table><thead><tr><th>组</th><th>文件</th><th>可释放</th></tr></thead><tbody id="duplicateRows"></tbody></table></div></section>
        </div>
        <section class="panel glass" style="margin-top:12px"><div class="panel-title"><h2>搜索结果</h2><span id="searchCount">尚未搜索</span></div><div class="table-scroll"><table><thead><tr><th>文件</th><th>路径</th><th>类型</th><th>大小</th></tr></thead><tbody id="searchRows"></tbody></table></div><div class="pager"><button class="command-button" id="searchPrev" type="button">上一页</button><span id="searchPage">0 / 0</span><button class="command-button" id="searchNext" type="button">下一页</button></div></section>
        <section class="panel glass" style="margin-top:12px"><div class="panel-title"><h2>导出</h2><span>当前扫描结果</span></div><div class="toolbar"><a class="command-button" href="{{ api_prefix }}/export/csv">CSV</a><a class="command-button" href="{{ api_prefix }}/export/json">JSON</a><a class="command-button" href="{{ api_prefix }}/export/html">HTML 报告</a></div></section>
      </section>

      <section class="view" id="view-history">
        <div class="section-heading"><div><h1>历史趋势</h1><p>读取本地 Snapshot，比较最近两次扫描</p></div></div>
        <div class="history-grid">
          <section class="panel glass"><div class="panel-title"><h2>空间变化</h2><span id="historyDelta"></span></div><svg class="trend-chart" id="trendChart" viewBox="0 0 800 290" preserveAspectRatio="none" aria-label="空间变化折线图"></svg></section>
          <section class="panel glass"><div class="panel-title"><h2>增长最快目录</h2><span>最近两次</span></div><div class="bar-list" id="growthBars"></div></section>
        </div>
        <div class="content-grid">
          <section class="panel glass"><div class="panel-title"><h2>历史扫描记录</h2><span id="historyCount"></span></div><div class="table-scroll"><table><thead><tr><th>时间</th><th>大小</th><th>文件</th><th>目录</th><th>Schema</th></tr></thead><tbody id="historyRows"></tbody></table></div></section>
          <section class="panel glass"><div class="panel-title"><h2>最近进入大文件榜</h2><span>Top 10</span></div><div class="table-scroll"><table><thead><tr><th>文件</th><th>大小</th></tr></thead><tbody id="recentFileRows"></tbody></table></div></section>
        </div>
      </section>

      <section class="view" id="view-system">
        <div class="section-heading"><div><h1>运行状态</h1><p>本地服务、运行环境与当前分析任务的诊断信息</p></div><button class="command-button" id="refreshDiagnostics" type="button">刷新</button></div>
        <section class="panel glass"><div class="panel-title"><h2>系统诊断</h2><span id="diagnosticUpdated">尚未读取</span></div><div class="diagnostic-grid" id="diagnosticGrid"></div></section>
        <section class="panel glass" style="margin-top:12px"><div class="panel-title"><h2>隐私与安全</h2><span>仅本机访问</span></div><p style="margin:0;color:var(--text-secondary);font-size:13px;line-height:1.7">Dashboard 仅绑定本机回环地址，拒绝不受信任的 Host 与 Origin。所有扫描、搜索和导出操作均在本机完成，软件不会自动删除任何文件。</p></section>
      </section>
    </main>
  </div>

  <script nonce="{{ nonce }}">
    const API_PREFIX = {{ api_prefix | tojson }};
    const PAGE_SIZE = 100;
    const state = { result: null, treePath: '', treeOffset: 0, status: null, loadedTask: null, searchOffset: 0, searchData: null };
    const byId = id => document.getElementById(id);
    const formatNumber = value => new Intl.NumberFormat('zh-CN').format(value || 0);
    const api = async (path, options = {}) => {
      const response = await fetch(path, { cache: 'no-store', ...options });
      const type = response.headers.get('content-type') || '';
      const value = type.includes('json') ? await response.json() : await response.text();
      if (!response.ok) {
        const message = value?.error || `请求失败 (${response.status})`;
        const error = new Error(value?.request_id ? `${message}（请求 ID: ${value.request_id}）` : message);
        error.code = value?.code || 'REQUEST_FAILED';
        throw error;
      }
      return value;
    };
    const clear = node => { while (node.firstChild) node.removeChild(node.firstChild); };
    const text = (tag, value, className) => {
      const node = document.createElement(tag); node.textContent = String(value ?? '');
      if (className) node.className = className; return node;
    };
    const setTheme = theme => {
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem('diskvis-dashboard-theme', theme); } catch (error) { /* Storage can be disabled by policy. */ }
    };
    let storedTheme = null;
    try { storedTheme = localStorage.getItem('diskvis-dashboard-theme'); } catch (error) { /* Follow the OS theme. */ }
    setTheme(storedTheme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'));
    byId('themeToggle').addEventListener('click', () => setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'));

    document.querySelectorAll('.tab').forEach(button => button.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(item => item.setAttribute('aria-selected', String(item === button)));
      document.querySelectorAll('.view').forEach(view => view.classList.toggle('active', view.id === `view-${button.dataset.view}`));
      if (button.dataset.view === 'history' && state.result) loadHistory().catch(error => showError(error.message));
      if (button.dataset.view === 'system') loadDiagnostics().catch(error => showError(error.message));
    }));

    function renderStatus(status) {
      state.status = status;
      byId('statusDot').className = `status-dot ${status.state === 'running' ? 'running' : ''}`;
      byId('statusPath').textContent = status.current_path || status.root;
      byId('statusFiles').textContent = `${formatNumber(status.files_scanned)} 个文件 / ${formatNumber(status.dirs_scanned)} 个目录`;
      byId('statusSpeed').textContent = `${status.files_per_second} 文件/秒`;
      if (status.state === 'completed') byId('statusEta').textContent = '扫描完成';
      else if (status.state === 'error' && status.has_result) byId('statusEta').textContent = '扫描失败，显示上次结果';
      else if (status.state === 'cancelled' && status.has_result) byId('statusEta').textContent = '扫描已取消，显示上次结果';
      else if (status.state !== 'running') byId('statusEta').textContent = '等待扫描';
      else byId('statusEta').textContent = status.estimated_remaining_seconds == null ? '剩余时间计算中' : `预计 ${status.estimated_remaining_seconds} 秒`;
      byId('cancelButton').disabled = status.state !== 'running';
      byId('rescanButton').disabled = status.state === 'running';
      if (status.state === 'error') showError(status.has_result ? `${status.error || '扫描失败'}。当前仍显示上次成功结果。` : (status.error || '扫描失败'));
      if (status.state === 'cancelled') showError(status.has_result ? '扫描已取消，当前仍显示上次成功结果。' : '扫描已取消，没有生成不完整结果。');
      if (status.state === 'completed' && status.snapshot_error) showNotice(`扫描成功，但 Snapshot 保存失败：${status.snapshot_error}`, true);
    }

    function showError(message) { const node = byId('errorNotice'); node.textContent = message; node.style.display = 'block'; }
    function showNotice(message, warning = false) { const node = byId('errorNotice'); node.classList.toggle('warning', warning); node.textContent = message; node.style.display = 'block'; }
    function hideError() { const node = byId('errorNotice'); node.style.display = 'none'; node.classList.remove('warning'); }

    async function pollStatus() {
      try {
        const status = await api(`${API_PREFIX}/status`); renderStatus(status);
        if (status.has_result && state.loadedTask !== status.result_task_id) {
          await loadResult(); state.loadedTask = status.result_task_id;
        }
      } catch (error) { showError(error.message); }
      window.setTimeout(pollStatus, state.status?.state === 'running' ? 450 : 1200);
    }

    async function loadResult() {
      state.result = await api(`${API_PREFIX}/result`);
      byId('loadingState').style.display = 'none';
      if (!document.querySelector('.view.active')) byId('view-overview').classList.add('active');
      renderOverview(state.result); renderAnalysis(state.result); await loadTree(''); await loadHistory();
    }

    function metric(label, value, detail) {
      const node = document.createElement('article'); node.className = 'metric glass';
      node.append(text('div', label, 'metric-label'), text('div', value, 'metric-value'), text('div', detail, 'metric-detail'));
      return node;
    }

    function renderOverview(data) {
      const summary = data.summary, overview = data.overview, grid = byId('metricGrid'); clear(grid);
      [
        ['磁盘总容量', overview.disk_total_human, overview.root],
        ['已使用空间', overview.disk_used_human, `${overview.disk_used_percent}%`],
        ['扫描目录大小', summary.total_size_human, '当前筛选范围'],
        ['文件数量', formatNumber(summary.total_files), `${formatNumber(data.scan_error_count)} 个错误`],
        ['文件夹数量', formatNumber(summary.total_folders), '包含扫描根目录'],
        ['扫描耗时', summary.scan_seconds_text, overview.last_scan_time || '刚刚'],
      ].forEach(item => grid.append(metric(...item)));
      const angle = overview.disk_used_percent / 100 * 360;
      byId('capacityRing').style.setProperty('--used-angle', `${angle}deg`);
      byId('capacityPercent').textContent = `${overview.disk_used_percent}%`;
      byId('capacityLabel').textContent = `${overview.disk_free_human} 可用`;
      renderLegend([
        ['已使用', overview.disk_used_human, 'var(--accent-color)'],
        ['可用', overview.disk_free_human, 'var(--accent-blue)'],
        ['当前扫描目录', summary.total_size_human, 'var(--accent-orange)'],
      ]);
      renderBars(byId('folderBars'), data.folder_stats.slice(0, 10), 'total_size', 'path', 'total_size_human', 'var(--accent-orange)');
    }

    function renderLegend(items) {
      const root = byId('capacityLegend'); clear(root);
      items.forEach(([label, value, color]) => { const row = document.createElement('div'); row.className = 'legend-row'; const swatch = text('span','', 'swatch'); swatch.style.background = color; row.append(swatch, text('span',label), text('strong',value)); root.append(row); });
    }

    function renderBars(root, items, valueKey, labelKey, humanKey, color = 'var(--accent-blue)') {
      clear(root); const max = Math.max(1, ...items.map(item => Number(item[valueKey]) || 0));
      if (!items.length) { root.append(text('div', '暂无数据', 'empty')); return; }
      items.forEach(item => { const row = document.createElement('div'); row.className = 'bar-row'; const track = text('div','', 'bar-track'); const fill = text('div','', 'bar-fill'); fill.style.width = `${Math.max(1, (Number(item[valueKey]) || 0) / max * 100)}%`; fill.style.background = color; track.append(fill); const label = text('div', item[labelKey], 'bar-label'); label.title = String(item[labelKey]); row.append(label, track, text('strong', item[humanKey] ?? formatNumber(item[valueKey]))); root.append(row); });
    }

    async function loadTree(path, offset = 0) {
      const data = await api(`${API_PREFIX}/tree?path=${encodeURIComponent(path)}&offset=${offset}&limit=${PAGE_SIZE}`);
      state.treePath = path; state.treeOffset = offset;
      renderBreadcrumbs(data.breadcrumbs); renderTreemap(data.directories); renderDirectoryMeta(data);
      byId('upButton').disabled = data.parent_path == null;
      byId('upButton').dataset.path = data.parent_path ?? '';
    }

    function renderBreadcrumbs(items) {
      const root = byId('breadcrumbs'); clear(root);
      items.forEach((item, index) => { const button = text('button', item.name, 'breadcrumb-button'); button.type = 'button'; button.addEventListener('click', () => loadTree(item.path).catch(error => showError(error.message))); root.append(button); if (index < items.length - 1) root.append(text('span','/')); });
    }

    function splitTreemap(items, x, y, width, height, depth = 0) {
      if (!items.length) return [];
      if (items.length === 1) return [{ item: items[0], x, y, width, height }];
      const total = items.reduce((sum, item) => sum + Math.max(1, item.recursive_size), 0); let sum = 0, split = 1;
      for (; split < items.length; split += 1) { sum += Math.max(1, items[split - 1].recursive_size); if (sum >= total / 2) break; }
      const first = items.slice(0, split), second = items.slice(split), ratio = sum / total;
      if (width >= height) return [...splitTreemap(first, x, y, width * ratio, height, depth + 1), ...splitTreemap(second, x + width * ratio, y, width * (1-ratio), height, depth + 1)];
      return [...splitTreemap(first, x, y, width, height * ratio, depth + 1), ...splitTreemap(second, x, y + height * ratio, width, height * (1-ratio), depth + 1)];
    }

    function renderTreemap(items) {
      const root = byId('treemap'); clear(root);
      if (!items.length) { root.append(text('div','该目录没有子目录','empty')); return; }
      const colors = ['#62d7c9','#72a7ff','#ffb25f','#ff7e9f','#b8a5ff','#86d18b'];
      splitTreemap(items, 0, 0, 100, 100).forEach((entry, index) => {
        const button = document.createElement('button'); button.className = 'tree-cell'; button.type = 'button'; button.style.left = `${entry.x}%`; button.style.top = `${entry.y}%`; button.style.width = `${entry.width}%`; button.style.height = `${entry.height}%`; button.style.background = colors[index % colors.length];
        button.append(text('strong', entry.item.name), text('small', `${entry.item.recursive_size_human} · ${entry.item.percent}%`));
        button.title = `${entry.item.relative_path}\n${entry.item.recursive_size_human}\n${entry.item.recursive_file_count} 个文件`;
        button.addEventListener('click', () => loadTree(entry.item.relative_path).catch(error => showError(error.message))); root.append(button);
      });
    }

    function renderDirectoryMeta(data) {
      const item = data.current; byId('directoryName').textContent = item.name; byId('directoryPercent').textContent = `${item.percent}%`;
      const root = byId('directoryMeta'); clear(root);
      [['递归大小', item.recursive_size_human], ['直接大小', item.direct_size_human], ['文件', formatNumber(item.recursive_file_count)], ['子目录', formatNumber(item.child_count)]].forEach(([label,value]) => { const box = text('div','', 'meta-item'); box.append(text('span',label), text('strong',value)); root.append(box); });
      const rows = byId('directoryFiles'); clear(rows); data.files.forEach(file => { const row = document.createElement('tr'); const name = text('td', file.name); name.title = file.path; row.append(name, text('td', file.size_human)); rows.append(row); });
      const page = data.file_page;
      byId('directoryFileCount').textContent = `${formatNumber(page.total)} 个`;
      byId('directoryPage').textContent = page.total ? `${formatNumber(page.offset + 1)}-${formatNumber(page.offset + page.returned)} / ${formatNumber(page.total)}` : '0 / 0';
      byId('directoryPrev').disabled = page.offset === 0;
      byId('directoryNext').disabled = !page.has_more;
    }

    function renderAnalysis(data) {
      renderBars(byId('largestBars'), data.largest_files, 'size', 'path', 'size_human');
      renderBars(byId('typeBars'), data.type_stats, 'total_size', 'suffix', 'total_size_human', 'var(--accent-rose)');
      const distributions = Object.entries(data.size_distribution).map(([name,value]) => ({ name, value, human: formatNumber(value) }));
      renderBars(byId('distributionBars'), distributions, 'value', 'name', 'human', 'var(--accent-orange)');
      const summary = byId('duplicateSummary'); summary.textContent = data.duplicates_scanned ? `${data.duplicate_group_count} 组 · ${data.duplicate_potential_saved_size_human}` : '未执行检测';
      const rows = byId('duplicateRows'); clear(rows); data.duplicates.forEach((group,index) => { const row = document.createElement('tr'); const fileCell = text('td', group.files.slice(0, 3).join(' · '), 'path'); fileCell.title = group.files.join('\n'); row.append(text('td', `#${index+1}`), fileCell, text('td', group.potential_saved_size_human)); rows.append(row); });
    }

    async function runSearch(reset = true) {
      const query = byId('searchInput').value, raw = byId('minSizeInput').value.trim(); const minSize = raw ? Number(raw) : 0;
      if (!Number.isFinite(minSize) || minSize < 0) { showError('最小大小必须是非负字节数。'); return; }
      if (reset) state.searchOffset = 0;
      hideError(); const data = await api(`${API_PREFIX}/search?q=${encodeURIComponent(query)}&min_size=${Math.floor(minSize)}&offset=${state.searchOffset}&limit=${PAGE_SIZE}`);
      state.searchData = data;
      byId('searchCount').textContent = `${formatNumber(data.count)} 条结果`; const rows = byId('searchRows'); clear(rows);
      data.results.forEach(file => { const row = document.createElement('tr'); const path = text('td',file.relative_path,'path'); path.title = file.path; row.append(text('td',file.name),path,text('td',file.suffix),text('td',file.size_human)); rows.append(row); });
      byId('searchPage').textContent = data.count ? `${formatNumber(data.offset + 1)}-${formatNumber(data.offset + data.returned_count)} / ${formatNumber(data.count)}` : '0 / 0';
      byId('searchPrev').disabled = data.offset === 0;
      byId('searchNext').disabled = !data.has_more;
    }

    async function loadHistory() {
      const data = await api(`${API_PREFIX}/history`); byId('historyDelta').textContent = data.total_size_delta_human; byId('historyCount').textContent = `${data.record_count} 次`;
      renderTrend(data.records); renderBars(byId('growthBars'), data.growing_folders, 'size_delta', 'relative_path', 'size_delta_human', 'var(--accent-rose)');
      const rows = byId('historyRows'); clear(rows); data.records.slice().reverse().forEach(item => { const row = document.createElement('tr'); row.append(text('td',item.timestamp),text('td',item.total_size_human),text('td',formatNumber(item.file_count)),text('td',formatNumber(item.folder_count)),text('td',`v${item.schema_version}`)); rows.append(row); });
      const files = byId('recentFileRows'); clear(files); data.recent_large_files.forEach(file => { const row = document.createElement('tr'); const name = text('td',file.relative_path,'path'); name.title = file.path; row.append(name,text('td',file.size_human)); files.append(row); });
    }

    async function loadDiagnostics() {
      const data = await api(`${API_PREFIX}/diagnostics`);
      const root = byId('diagnosticGrid'); clear(root);
      const values = [
        ['应用版本', `v${data.application.version} / API v${data.application.api_version}`],
        ['服务实例', data.application.instance_id],
        ['Python', `${data.runtime.implementation} ${data.runtime.python}`],
        ['操作系统', data.runtime.platform],
        ['进程', `PID ${data.runtime.process_id}`],
        ['运行时间', `${Math.round(data.runtime.uptime_seconds)} 秒`],
        ['任务状态', `${data.analysis.state} / #${data.analysis.task_id}`],
        ['扫描计数', `${formatNumber(data.analysis.files_scanned)} 文件 / ${formatNumber(data.analysis.dirs_scanned)} 目录`],
        ['日志文件', data.server.logging_enabled ? data.server.log_path : `不可用：${data.server.logging_error || '未知原因'}`],
      ];
      values.forEach(([label, value]) => { const item = text('div', '', 'diagnostic-item'); item.append(text('span', label), text('strong', value)); root.append(item); });
      byId('diagnosticUpdated').textContent = `更新于 ${new Date().toLocaleTimeString('zh-CN')}`;
    }

    function renderTrend(records) {
      const svg = byId('trendChart'); clear(svg);
      if (records.length < 2) { const label = document.createElementNS('http://www.w3.org/2000/svg','text'); label.setAttribute('x','400'); label.setAttribute('y','145'); label.setAttribute('text-anchor','middle'); label.setAttribute('fill','currentColor'); label.textContent = '至少需要两次 Snapshot 才能显示趋势'; svg.append(label); return; }
      const values = records.map(item => item.total_size), min = Math.min(...values), max = Math.max(...values), span = Math.max(1,max-min);
      const points = records.map((item,index) => ({ x: 38 + index / Math.max(1,records.length-1) * 724, y: 250 - (item.total_size-min)/span*210, item }));
      const pathData = points.map((p,index) => `${index?'L':'M'} ${p.x} ${p.y}`).join(' '); const area = document.createElementNS('http://www.w3.org/2000/svg','path'); area.setAttribute('d', `${pathData} L ${points.at(-1).x} 260 L ${points[0].x} 260 Z`); area.setAttribute('class','trend-area'); svg.append(area);
      const line = document.createElementNS('http://www.w3.org/2000/svg','path'); line.setAttribute('d',pathData); line.setAttribute('class','trend-line'); svg.append(line);
      points.forEach(point => { const circle = document.createElementNS('http://www.w3.org/2000/svg','circle'); circle.setAttribute('cx',point.x); circle.setAttribute('cy',point.y); circle.setAttribute('r','6'); circle.setAttribute('class','trend-dot'); const title = document.createElementNS('http://www.w3.org/2000/svg','title'); title.textContent = `${point.item.timestamp}: ${point.item.total_size_human}`; circle.append(title); svg.append(circle); });
    }

    byId('upButton').addEventListener('click', event => loadTree(event.currentTarget.dataset.path || '').catch(error => showError(error.message)));
    byId('directoryPrev').addEventListener('click', () => loadTree(state.treePath, Math.max(0, state.treeOffset - PAGE_SIZE)).catch(error => showError(error.message)));
    byId('directoryNext').addEventListener('click', () => loadTree(state.treePath, state.treeOffset + PAGE_SIZE).catch(error => showError(error.message)));
    byId('searchButton').addEventListener('click', () => runSearch().catch(error => showError(error.message)));
    byId('searchInput').addEventListener('keydown', event => { if (event.key === 'Enter') runSearch().catch(error => showError(error.message)); });
    byId('searchPrev').addEventListener('click', () => { state.searchOffset = Math.max(0, state.searchOffset - PAGE_SIZE); runSearch(false).catch(error => showError(error.message)); });
    byId('searchNext').addEventListener('click', () => { state.searchOffset += PAGE_SIZE; runSearch(false).catch(error => showError(error.message)); });
    byId('refreshDiagnostics').addEventListener('click', () => loadDiagnostics().catch(error => showError(error.message)));
    byId('cancelButton').addEventListener('click', () => api(`${API_PREFIX}/cancel`,{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}).catch(error => showError(error.message)));
    byId('rescanButton').addEventListener('click', async () => { hideError(); if (!state.result) byId('loadingState').style.display = 'grid'; try { await api(`${API_PREFIX}/scan`,{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}); } catch(error) { showError(error.message); } });
    pollStatus();
  </script>
</body>
</html>
